# =====================================================================
# Digital Dental Notebook — Environment Configuration Template
# Copy this file to .env and fill in secure random values.
# NEVER commit your actual .env file to version control.
# =====================================================================

NODE_ENV=development
PORT=3001
FRONTEND_PORT=5173

# Allowed CORS Origin(s), comma-separated (NEVER use * in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Database Connection (Optional external PostgreSQL URL; uses embedded PGlite with RLS if empty)
DATABASE_URL=

# Cryptographic Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
SIGNED_URL_SECRET=
BACKUP_ENCRYPTION_KEY=
WEBHOOK_SECRET=

# Initial Clinic Setup (Used only on first bootstrap if database is empty)
INITIAL_CLINIC_NAME=
INITIAL_CLINIC_EMAIL=
INITIAL_CLINIC_PASSWORD=

# Email / SMTP Configuration for Verification, Password Reset & Security Alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Private File Storage Directory (Outside public web root)
PRIVATE_STORAGE_DIR=./data/private_uploads
